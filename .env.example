# ── Telegram ──────────────────────────────────────────
# @BotFather dan olingan token
TELEGRAM_TOKEN=1234567890:AAABBBCCC-your-token-here

# ── Server ────────────────────────────────────────────
# Domeningiz (masalan: score.yourdomain.com)
# DNS da bu domen server IP'ga yo'naltirilgan bo'lishi kerak
DOMAIN=score.yourdomain.com

# Let's Encrypt uchun email (sertifikat eslatmalari keladi)
EMAIL=your@email.com

# Port (ixtiyoriy)
PORT=8080
